# ChainLens Academy — environment variables
# Copy to .env: cp .env.example .env

# --- Local development (default) ---
# SQLite file via libSQL — works with zero cloud setup
DATABASE_URL=file:./data/chainlens.db

# --- Production (Turso / Vercel) ---
# When both are set, Turso takes precedence over DATABASE_URL.
# Create: turso db create chainlens-academy
# URL:    turso db show chainlens-academy --url
# Token:  turso db tokens create chainlens-academy
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# CoinGecko API base (optional — defaults to public API)
# COINGECKO_API_URL=https://api.coingecko.com/api/v3

# App version shown in GET /api/health
APP_VERSION=1.0.0
